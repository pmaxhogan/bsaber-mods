<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generates a starter chapters.json from a map's editor bookmarks. All parsing lives in
       MaxTweaks.Core (unit tested); this is only the command-line shell. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>chapters-from-bookmarks</AssemblyName>
    <RootNamespace>ChaptersFromBookmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MaxTweaks.Core\MaxTweaks.Core.csproj" />
  </ItemGroup>
</Project>
