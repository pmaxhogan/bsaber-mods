<settings-container xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
  <!-- One section per feature. Layout rules learned the hard way (BSML 1.12.5): text must be wrapped in a
       <horizontal> or the settings list collapses; no tab-selector inside the settings container. A long
       word-wrapped help text needs pref-width='90' on its <horizontal>: otherwise its unwrapped width becomes
       the width of every row and the labels and controls are pushed outside the visible pane. -->
  <horizontal>
    <text text='~status-text' font-size='3' />
  </horizontal>

  <!-- Hide OSTs: owned by its feature; bindings resolve against host 'hide-ost'. -->
  <horizontal>
    <text text='Hide OSTs' italics='true' font-size='5' />
  </horizontal>
  <macro.as-host host='hide-ost'>
    <toggle-setting text='Enabled' value='enabled' apply-on-change='true'
    hover-hint='Show the hide-official-songs button in the solo song list header' />
    <toggle-setting text='Hide official songs' value='hidden' apply-on-change='true'
    hover-hint='Same as the song list button: hide OST, Extras and DLC packs so only custom maps remain' />
  </macro.as-host>

  <!-- Auto-reload: owned by its feature; bindings resolve against host 'auto-reload'. -->
  <horizontal>
    <text text='Auto-reload' italics='true' font-size='5' />
  </horizontal>
  <macro.as-host host='auto-reload'>
    <toggle-setting text='Enabled' value='enabled' apply-on-change='true' hover-hint='Watch the custom map folders and reload changed maps automatically' />
    <increment-setting text='Wait for quiet (seconds)' value='debounce-seconds' min='0.5' max='10' increment='0.5' apply-on-change='true' hover-hint='Reload once the map folders have had no changes for this long' />
    <toggle-setting text='Show toasts' value='show-toasts' apply-on-change='true' hover-hint='Show a short message after a reload, and when the map you are playing changes on disk' />
  </macro.as-host>

  <!-- Blink: owned by its feature; bindings resolve against host 'blink'. -->
  <horizontal>
    <text text='Blink' italics='true' font-size='5' />
  </horizontal>
  <macro.as-host host='blink'>
    <toggle-setting text='Enabled' value='enabled' apply-on-change='true' />
    <slider-setting text='Quiet before' value='quiet-before' min='0' max='10' increment='0.5' formatter='format-seconds' apply-on-change='true' hover-hint='No notes for this long before a blink can start.' />
    <slider-setting text='Clear ahead' value='clear-ahead' min='1' max='20' increment='0.5' formatter='format-seconds' apply-on-change='true' hover-hint='No notes and no walls at head height for this long ahead.' />
    <slider-setting text='Blink length' value='duration' min='1' max='10' increment='0.5' formatter='format-seconds' apply-on-change='true' hover-hint='Total overlay time, including 0.3 s fade in and fade out.' />
    <slider-setting text='Cooldown' value='cooldown' min='15' max='1800' increment='15' formatter='format-cooldown' apply-on-change='true' hover-hint='Minimum played time between blinks. Counts only gameplay and carries across songs.' />
    <slider-setting text='Vignette strength' value='vignette-strength' min='0' max='1' increment='0.05' formatter='format-percent' apply-on-change='true' hover-hint='Darkness at the corners of the view. The centre stays clear.' />
  </macro.as-host>

  <!-- Chapters: owned by its feature; bindings resolve against host 'chapters'. -->
  <horizontal>
    <text text='Chapters' italics='true' font-size='5' />
  </horizontal>
  <macro.as-host host='chapters'>
    <toggle-setting text='Enabled' value='enabled' apply-on-change='true' hover-hint='Show chapters from chapters.json next to Info.dat' />
    <toggle-setting text='Show progress bars' value='show-progress-bars' apply-on-change='true' hover-hint='Thin bar under each chapter name' />
    <horizontal pref-width='90'>
      <text text='Practice mode: point at &lt; or &gt; and press A (or click in the pause menu) to jump to the chapter start or end.' font-size='3' word-wrapping='true' />
    </horizontal>
  </macro.as-host>

  <!-- Difficulty switch: owned by its feature; bindings resolve against host 'difficulty-switch'. -->
  <horizontal>
    <text text='Difficulty switch' italics='true' font-size='5' />
  </horizontal>
  <macro.as-host host='difficulty-switch'>
    <toggle-setting text='Enabled' value='enabled' apply-on-change='true' hover-hint='Practice mode: hold Y to pick another difficulty of the same characteristic, release to switch' />
    <slider-setting text='Clear gap' value='clear-gap-seconds' min='0' max='10' increment='0.5' formatter='format-seconds' apply-on-change='true' hover-hint='Real seconds after a switch in which no new notes, bombs, walls, arcs or chains are due (at least one note flight; new notes start flying in before it ends)' />
    <toggle-setting text='Slide old notes' value='slide-old-notes' apply-on-change='true' hover-hint='Notes in flight slide up (harder) or down (easier) out of view instead of vanishing' />
    <horizontal pref-width='90'>
      <text text='Hold Y, flick the right stick up/down, release Y to switch. The song keeps playing; the level restarts only for maps that need Noodle/Chroma/360.' font-size='3' word-wrapping='true' />
    </horizontal>
  </macro.as-host>

  <!-- Active pause: owned by its feature; bindings resolve against host 'active-pause'. -->
  <horizontal>
    <text text='Active pause' italics='true' font-size='5' />
  </horizontal>
  <macro.as-host host='active-pause'>
    <toggle-setting text='Enabled' value='enabled' apply-on-change='true' hover-hint='Practice mode: press X to pause without the pause menu and step through the map' />
    <toggle-setting text='Ghost notes' value='ghost-notes' apply-on-change='true' hover-hint='Show notes, bombs, walls, arcs and chains mostly dissolved while active-paused (they cannot be hit)' />
    <horizontal pref-width='90'>
      <text text='Press X to pause in place, point a saber at a step button (-1m to +1m, b = beats) and press A. Press X again to resume.' font-size='3' word-wrapping='true' />
    </horizontal>
  </macro.as-host>

  <!-- Heart rate bridge: owned by its feature; bindings resolve against host 'heart-rate-bridge'. -->
  <horizontal>
    <text text='Heart rate bridge' italics='true' font-size='5' />
  </horizontal>
  <macro.as-host host='heart-rate-bridge'>
    <toggle-setting text='Enabled' value='enabled' apply-on-change='true' hover-hint='Start the Bluetooth strap to HRCounter bridge (UserData/MaxTweaks/hr_osc_bridge.py via uv) with the game and keep it running' />
    <toggle-setting text='Only with HRCounter' value='only-with-hrcounter' apply-on-change='true' hover-hint='Do not start the bridge when the HRCounter mod is not loaded' />
    <toggle-setting text='Show toasts' value='show-toasts' apply-on-change='true' hover-hint='Toast when the strap connects or drops' />
    <horizontal pref-width='90'>
      <text text='~bridge-status' font-size='3' word-wrapping='true' />
    </horizontal>
    <horizontal pref-width='90'>
      <text text='Wear the strap (wet electrodes) and set HRCounter to the OSC Protocol data source. Needs uv installed on this PC.' font-size='3' word-wrapping='true' />
    </horizontal>
  </macro.as-host>
</settings-container>
