<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MaxTweaks</PackageId>
    <Title>MaxTweaks</Title>
    <Authors>Max Hogan</Authors>
    <Description>Personal quality-of-life mods: hide OSTs, auto-reload maps, practice difficulty switch, blink breaks, chapters.</Description>
    <GameVersion>1.40.8</GameVersion>
    <Version>0.1.0</Version>
    <RepositoryUrl>https://github.com/pmaxhogan/bsaber-mods</RepositoryUrl>
    <ProjectHome>https://github.com/pmaxhogan/bsaber-mods</ProjectHome>
    <RootNamespace>MaxTweaks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <DependsOn Include="BSIPA" Version="^4.3.6" />
    <DependsOn Include="SiraUtil" Version="^3.2.1" />
    <DependsOn Include="BeatSaberMarkupLanguage" Version="^1.12.5" />
    <DependsOn Include="SongCore" Version="^3.15.3" />
  </ItemGroup>

  <!-- Pure, game-independent logic lives in MaxTweaks.Core (unit tested on .NET); its sources are
       compiled straight into this one plugin DLL so nothing extra ships in Libs/. -->
  <ItemGroup>
    <Compile Include="..\MaxTweaks.Core\**\*.cs" Exclude="..\MaxTweaks.Core\obj\**;..\MaxTweaks.Core\bin\**" LinkBase="Core" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.bsml" />
  </ItemGroup>

  <ItemGroup>
    <!-- BSIPA / mods -->
    <Reference Include="IPA.Loader" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\IPA.Loader.dll" />
    <Reference Include="0Harmony" HintPath="$(BeatSaberDir)Libs\0Harmony.dll" />
    <Reference Include="Hive.Versioning" HintPath="$(BeatSaberDir)Libs\Hive.Versioning.dll" />
    <Reference Include="Newtonsoft.Json" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\Newtonsoft.Json.dll" />
    <Reference Include="SiraUtil" HintPath="$(BeatSaberDir)Plugins\SiraUtil.dll" />
    <Reference Include="BSML" HintPath="$(BeatSaberDir)Plugins\BSML.dll" />
    <Reference Include="SongCore" HintPath="$(BeatSaberDir)Plugins\SongCore.dll" Publicize="true" />

    <!-- Game (publicized so private members can be reached by name) -->
    <Reference Include="Main" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\Main.dll" Publicize="true" />
    <Reference Include="BeatmapCore" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\BeatmapCore.dll" Publicize="true" />
    <Reference Include="GameplayCore" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\GameplayCore.dll" Publicize="true" />
    <Reference Include="DataModels" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\DataModels.dll" Publicize="true" />
    <Reference Include="HMLib" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\HMLib.dll" Publicize="true" />
    <Reference Include="HMUI" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\HMUI.dll" Publicize="true" />
    <Reference Include="BGLib.AppFlow" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\BGLib.AppFlow.dll" />
    <Reference Include="BGLib.UnityExtension" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\BGLib.UnityExtension.dll" />
    <Reference Include="BGLib.Polyglot" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\BGLib.Polyglot.dll" />
    <Reference Include="BeatSaber.ViewSystem" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\BeatSaber.ViewSystem.dll" />
    <Reference Include="Colors" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\Colors.dll" />
    <Reference Include="Tweening" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\Tweening.dll" />
    <Reference Include="Zenject" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\Zenject.dll" />
    <Reference Include="Zenject-usage" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\Zenject-usage.dll" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\Unity.TextMeshPro.dll" />

    <!-- Unity -->
    <Reference Include="UnityEngine" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\UnityEngine.AudioModule.dll" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\UnityEngine.IMGUIModule.dll" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\UnityEngine.InputLegacyModule.dll" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\UnityEngine.PhysicsModule.dll" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\UnityEngine.TextRenderingModule.dll" />
    <Reference Include="UnityEngine.UI" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\UnityEngine.UI.dll" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\UnityEngine.UIModule.dll" />
    <Reference Include="UnityEngine.VRModule" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\UnityEngine.VRModule.dll" />
    <Reference Include="UnityEngine.XRModule" HintPath="$(BeatSaberDir)Beat Saber_Data\Managed\UnityEngine.XRModule.dll" />
  </ItemGroup>
</Project>
